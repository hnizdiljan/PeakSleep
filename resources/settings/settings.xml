<settings>
    <setting propertyKey="@Properties.targetBB" title="@Strings.setTarget" prompt="@Strings.setTargetPrompt">
        <settingConfig type="numeric" required="true" min="50" max="100" />
    </setting>

    <setting propertyKey="@Properties.rateMode" title="@Strings.setRateMode">
        <settingConfig type="list">
            <listEntry value="0">@Strings.optAuto</listEntry>
            <listEntry value="1">@Strings.optManual</listEntry>
        </settingConfig>
    </setting>

    <setting propertyKey="@Properties.baseRechargeRate" title="@Strings.setRate" prompt="@Strings.setRatePrompt">
        <settingConfig type="numeric" required="true" min="1" max="30" />
    </setting>

    <setting propertyKey="@Properties.wakeSource" title="@Strings.setWakeSource">
        <settingConfig type="list">
            <listEntry value="0">@Strings.optProfile</listEntry>
            <listEntry value="1">@Strings.optManual</listEntry>
        </settingConfig>
    </setting>

    <setting propertyKey="@Properties.wakeUpHour" title="@Strings.setWakeHour">
        <settingConfig type="numeric" required="true" min="0" max="23" />
    </setting>

    <setting propertyKey="@Properties.wakeUpMinute" title="@Strings.setWakeMinute">
        <settingConfig type="numeric" required="true" min="0" max="59" />
    </setting>
</settings>
